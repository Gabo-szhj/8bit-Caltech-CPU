																		"TST X,o
		(!IR15 & IR14 & !IR13 & !IR12 & IR11 & IR10 & IR9 & !IR8)#		"TST S,o
		(!IR15 & !IR14 & IR13 & IR12 & !IR11 & IR10 & !IR9)#			"XOR (m)
																		"XOR X,o
		(!IR15 & !IR14 & IR13 & IR12 & !IR11 & IR10 & IR9 & !IR8)#		"XOR S,o
		(IR15 & !IR14 & !IR13 & !IR11 & !IR10)#							"LDD (m)
																		"LD S + o
																		"LD S+ + o
																		"LD +S + o
																		"IN p
		(IR15 & !IR14 & !IR13 & IR11 & IR9 & !IR8)#						"LD X- + o
																		"LD -X + o
																		"LD S- + o
																		"LD -S + o
		(IR15 & !IR14 & !IR13 & !IR11 & IR10 & IR9)#					"LD X + o
																		"LD X+ + o
																		"LDn+X + o
		(!IR15 & !IR14 & !IR13 & !IR12 & !IR11 & !IR10 & IR9 & !IR8)#	"POPF
		(RTS & (StateBits == Idle))#									"PC7:0 ¬ (S); S ¬ S + 1;
		RTS1)															"PC12:8 ¬ (S); S ¬ S + 1
		& !Clock;														"Read happens when clock is low



	WR = 	((IR15 & !IR14 & IR13 & !IR11)#									"STD m
																			"ST X + o
																			"ST X+ + o
																			"ST +X + o
																			"ST S + o
																			"ST S+ + o
																			"ST +S + o
																			"OUTp
			(IR15 & !IR14 & IR13 & IR11 & IR9 & !IR8)#						"ST X- + o
																			"ST -X + o
																			"ST S- + o
																			"ST -S + o
			(!IR15 & !IR14 & !IR13 & !IR12 & IR11)#							"PUSHF
			Call2#															" S ¬ S – 1; (S) ¬ (PC + 1)7:0; 
																			" PC ¬ a
			Call0)															"S ¬ S – 1; (S) ¬ (PC + 1)12:8;
			& !Clock;														"Write happens when clock is low

	IO = (IR15 & !IR14 & IR12 & !IR11 & !IR10 & !IR9 & !IR8);		"INp
																	"OUTp


END ControlAccess


